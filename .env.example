# Tu correo de Google (el mismo que guardaste en private.app_config)
ALLOWED_EMAIL=tu-correo@gmail.com

# Supabase → Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Google Cloud → Google Auth Platform → Clients
GOOGLE_CLIENT_ID=....apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# Generar con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Generar con: openssl rand -hex 32
CRON_SECRET=

APP_TZ=Europe/Madrid

# Se queda vacía hasta la Fase 3 (Google AI Studio, proyecto sin facturación)
GEMINI_API_KEY=
